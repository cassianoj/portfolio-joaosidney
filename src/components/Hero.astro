---
import type { Locale } from "../i18n";
import { useTranslations } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const copy =
  locale === "pt"
    ? {
        eyebrow: "Especialista em Dados · Porto Bank",
        name: "João Sidney Cassiano",
        pitch:
          "Trajetória híbrida em engenharia industrial, controladoria, ciência de dados e empreendedorismo. Construo soluções de dados que entendem o negócio — porque já vivi cada camada dele.",
        ctaProjects: t("nav.projects"),
        ctaContact: t("nav.contact"),
        projectsHref: "/pt/projetos",
        contactHref: "/pt/contato",
        stats: [
          { value: "14+", label: "anos no mercado" },
          { value: "3", label: "stacks complementares" },
          { value: "1", label: "produto fundado" },
        ],
      }
    : {
        eyebrow: "Data Specialist · Porto Bank",
        name: "João Sidney Cassiano",
        pitch:
          "Hybrid path across industrial engineering, controllership, data science and entrepreneurship. I build data solutions that actually understand the business — because I've lived every layer of it.",
        ctaProjects: t("nav.projects"),
        ctaContact: t("nav.contact"),
        projectsHref: "/en/projects",
        contactHref: "/en/contact",
        stats: [
          { value: "14+", label: "years in the market" },
          { value: "3", label: "complementary stacks" },
          { value: "1", label: "founded product" },
        ],
      };
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-40"
    aria-hidden="true"
  >
    <div
      class="absolute left-1/2 top-0 h-[600px] w-[800px] -translate-x-1/2 rounded-full"
      style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 60%); filter: blur(120px);"
    >
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <p class="font-mono text-sm text-accent">{copy.eyebrow}</p>
        <h1
          class="mt-3 text-4xl font-bold tracking-tight text-fg sm:text-5xl lg:text-6xl"
        >
          {copy.name}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-fg-muted">
          {copy.pitch}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={copy.projectsHref}
            class="inline-flex items-center justify-center rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-bg transition-colors hover:bg-accent-hover"
          >
            {copy.ctaProjects}
          </a>
          <a
            href={copy.contactHref}
            class="inline-flex items-center justify-center rounded-md border border-border bg-surface px-5 py-2.5 text-sm font-medium text-fg transition-colors hover:border-accent hover:text-accent"
          >
            {copy.ctaContact}
          </a>
        </div>

        <dl class="mt-12 grid max-w-md grid-cols-3 gap-4 border-t border-border pt-6">
          {
            copy.stats.map((stat) => (
              <div>
                <dt class="font-mono text-xs uppercase tracking-wider text-fg-muted">
                  {stat.label}
                </dt>
                <dd class="mt-1 text-2xl font-bold text-fg">{stat.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="hidden lg:flex lg:justify-center">
        <div
          class="aspect-square w-full max-w-sm rounded-2xl border border-border bg-surface shadow-2xl shadow-accent/10"
        >
          <div class="flex h-full items-center justify-center text-fg-muted">
            <div class="text-center">
              <div
                class="mx-auto mb-3 flex h-20 w-20 items-center justify-center rounded-full bg-surface-2 font-mono text-3xl text-accent"
              >
                JS
              </div>
              <p class="font-mono text-xs uppercase tracking-wider">
                {locale === "pt" ? "Foto profissional aqui" : "Headshot placeholder"}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

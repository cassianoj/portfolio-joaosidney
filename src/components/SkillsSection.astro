---
import { skillGroups, skillGroupTitle, skillGroupDescription } from "../data/skills";
import SkillBadge from "./SkillBadge.astro";
import type { Locale } from "../i18n";

interface Props {
  locale: Locale;
  headingPt?: string;
  headingEn?: string;
}

const { locale, headingPt = "Skills", headingEn = "Skills" } = Astro.props;
const heading = locale === "pt" ? headingPt : headingEn;
const intro =
  locale === "pt"
    ? "Três stacks que se complementam — não três tentativas isoladas."
    : "Three stacks that compound — not three isolated attempts.";
---

<section class="border-t border-border bg-surface/30">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
    <header class="mb-10 max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight text-fg sm:text-3xl">{heading}</h2>
      <p class="mt-3 text-fg-muted">{intro}</p>
    </header>

    <div class="grid gap-6 md:grid-cols-3">
      {
        skillGroups.map((group) => (
          <article class="rounded-lg border border-border bg-surface p-6">
            <h3 class="font-semibold text-fg">{skillGroupTitle(group, locale)}</h3>
            <p class="mt-2 text-sm text-fg-muted">
              {skillGroupDescription(group, locale)}
            </p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li>
                  <SkillBadge label={item} />
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

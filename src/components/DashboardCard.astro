---
import type { Locale } from "../i18n";
import SkillBadge from "./SkillBadge.astro";

interface Props {
  locale: Locale;
  slug: string;
  title: string;
  contexto: string;
  tecnologias: string[];
  date: Date;
  capa?: string;
}

const { locale, slug, title, contexto, tecnologias, date, capa } = Astro.props;

const href = `/${locale}/dashboards/${slug}`;
const year = new Date(date).getFullYear();
const topTech = tecnologias.slice(0, 4);
const extraTech = tecnologias.length - topTech.length;
---

<article
  class="group flex flex-col overflow-hidden rounded-lg border border-border bg-surface transition-all hover:-translate-y-0.5 hover:border-accent"
>
  <a href={href} class="flex h-full flex-col">
    {
      capa ? (
        <div class="aspect-[16/9] overflow-hidden bg-surface-2">
          <img
            src={capa}
            alt={title}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          />
        </div>
      ) : (
        <div class="flex aspect-[16/9] items-center justify-center bg-surface-2">
          <span class="font-mono text-xs uppercase tracking-wider text-fg-muted">
            Power BI
          </span>
        </div>
      )
    }

    <div class="flex flex-1 flex-col gap-3 p-5">
      <div class="flex items-center justify-between gap-3">
        <span class="font-mono text-xs uppercase tracking-wider text-accent">
          {contexto}
        </span>
        <span class="font-mono text-xs text-fg-muted">{year}</span>
      </div>

      <h3 class="text-lg font-semibold leading-tight text-fg group-hover:text-accent">
        {title}
      </h3>

      <ul class="mt-auto flex flex-wrap gap-1.5 pt-2">
        {topTech.map((tech) => <li><SkillBadge label={tech} /></li>)}
        {extraTech > 0 && (
          <li class="font-mono text-xs text-fg-muted self-center">
            +{extraTech}
          </li>
        )}
      </ul>
    </div>
  </a>
</article>

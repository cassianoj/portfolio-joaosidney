---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
import ProjectFilters from "../../../components/ProjectFilters.tsx";
import { useTranslations } from "../../../i18n";

const locale = "en" as const;
const t = useTranslations(locale);

const all = await getCollection("projetos");
const projects = all
  .filter((entry) => entry.id.startsWith("en/"))
  .sort(
    (a, b) =>
      new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  );

const categories = Array.from(
  new Set(projects.map((p) => p.data.categoria)),
).map((value) => ({ value, label: t(`projects.category.${value}` as any) }));

const contexts = Array.from(
  new Set(projects.map((p) => p.data.contexto)),
).map((value) => ({ value, label: t(`projects.context.${value}` as any) }));
---

<Base locale={locale} title={`${t("projects.title")} — João Sidney Cassiano`}>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
    <header class="mb-10">
      <p class="font-mono text-sm text-accent">{t("projects.title")}</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-fg sm:text-5xl">
        Projects & case studies
      </h1>
      <p class="mt-4 max-w-3xl text-lg text-fg-muted">{t("projects.intro")}</p>
    </header>

    <div class="mb-8">
      <ProjectFilters
        client:load
        categories={categories}
        contexts={contexts}
        labels={{
          category: t("projects.filter.category"),
          context: t("projects.filter.context"),
          all: t("projects.filter.all"),
          clear: t("projects.filter.clear"),
          empty: t("projects.empty"),
        }}
      />
    </div>

    {
      projects.length === 0 ? (
        <p class="text-fg-muted">{t("projects.empty")}</p>
      ) : (
        <>
          <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {projects.map((p) => (
              <li>
                <ProjectCard
                  locale={locale}
                  slug={p.data.slug}
                  title={p.data.title}
                  empresa={p.data.empresa}
                  contexto={p.data.contexto}
                  categoria={p.data.categoria}
                  tecnologias={p.data.tecnologias}
                  date={p.data.date}
                  destaque={p.data.destaque}
                  capa={p.data.capa}
                />
              </li>
            ))}
          </ul>
          <p
            id="projects-empty"
            class="mt-8 hidden text-center font-mono text-sm text-fg-muted"
          >
            {t("projects.empty")}
          </p>
        </>
      )
    }
  </section>
</Base>
